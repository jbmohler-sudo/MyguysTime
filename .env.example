# --- DATABASE (Direct Connection - No Pooler) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# --- SUPABASE AUTH (Frontend & Backend) ---
# These must match exactly for the Auth Bridge to work
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# VITE_ prefixes are required for the React frontend to see them
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Public site URL used for invite links and production CORS
APP_URL="http://localhost:5173"
CORS_ORIGINS="http://localhost:5173"

# --- SERVER CONFIG ---
PORT="3001"
NODE_ENV="development"

# Optional extra complimentary-access emails (comma-separated).
# jbmohler@gmail.com is always included in code — no env required.
# PLATFORM_COMPLIMENTARY_EMAILS="owner@example.com"
# VITE_PLATFORM_COMPLIMENTARY_EMAILS="owner@example.com"

# --- SENTRY (Optional - Keep empty if not using yet) ---
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_VERIFY_ENABLED="false"
VITE_SENTRY_DSN=""
VITE_SENTRY_ENVIRONMENT="development"
VITE_SENTRY_RELEASE=""
VITE_SENTRY_TRACES_SAMPLE_RATE="0"
VITE_SENTRY_VERIFY_ENABLED="false"
POSTHOG_PROJECT_TOKEN=""
POSTHOG_HOST="https://us.i.posthog.com"
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://us.i.posthog.com"
