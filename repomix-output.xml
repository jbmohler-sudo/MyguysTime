            onClick={onClose}
            disabled={isExporting}
            type="button"
            style={{
              padding: "10px 20px",
              borderRadius: "6px",
              border: `1px solid ${BRAND_LIGHT}`,
              backgroundColor: "white",
              color: BRAND_DARK,
              fontSize: "14px",
              fontWeight: 500,
              cursor: isExporting ? "not-allowed" : "pointer",
              opacity: isExporting ? 0.6 : 1,
              transition: "all 0.2s ease",
