.main { padding: 20px 24px 60px; max-width: 1200px; margin: 0 auto; }
.mode-banner {
  background: white; border-left: 4px solid var(--orange);
  padding: 10px 16px; border-radius: 0 8px 8px 0;
  display: flex; align-items: center; gap: 10px; font-size: .82rem;
  box-shadow: var(--shadow); margin-bottom: 16px;
}
.mode-banner--truck { border-left-color: var(--teal); }
.mode-banner strong { white-space: nowrap; }

/* ── Generic panel ── */
.panel {
  background: white; border: 1px solid var(--border);
  border-radius: var(--radius); box-shadow: var(--shadow); margin-bottom: 16px; overflow: hidden;
}
.panel-header {
  padding: 16px 20px 12px; border-bottom: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;
}
.eyebrow { font-size: .67rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--orange); margin-bottom: 3px; }
.panel-title { font-size: 1.05rem; font-weight: 700; color: var(--dark); margin-bottom: 3px; }
.panel-sub { font-size: .8rem; color: var(--muted); }
.toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.btn { padding: 7px 14px; border-radius: 8px; font-size: .8rem; font-weight: 600; cursor: pointer; border: none; transition: all .15s; }
.btn-primary { background: var(--orange); color: white; }
.btn-primary:hover { background: var(--orange-strong); }
.btn-ghost { background: none; color: var(--dark); border: 1.5px solid var(--border); }
.btn-ghost:hover { background: #f5f5f5; border-color: #bbb; }
.btn-success { background: var(--green); color: white; }
.btn-success:hover { background: #1a6040; }
.btn-purple { background: var(--purple); color: white; }
.btn-sm { padding: 5px 11px; font-size: .75rem; }

/* ── Stats ── */
.stats-row { display: flex; gap: 10px; padding: 14px 20px; border-bottom: 1px solid var(--border); background: #fafbfd; flex-wrap: wrap; }
.stat-card { background: white; border: 1px solid var(--border); border-radius: 10px; padding: 12px 16px; min-width: 120px; flex: 1; }
.stat-label { font-size: .7rem; color: var(--muted); font-weight: 600; margin-bottom: 3px; }
.stat-value { font-size: 1.35rem; font-weight: 800; color: var(--dark); }
.stat-value--orange { color: var(--orange); }
.stat-value--green { color: var(--green); }
.stat-helper { font-size: .67rem; color: var(--muted); margin-top: 2px; }

/* ── Chips ── */
.chip { padding: 3px 10px; border-radius: 999px; font-size: .7rem; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
.chip--ok { background: var(--green-soft); color: var(--green); }
.chip--warn { background: var(--yellow-soft); color: var(--yellow); }
.chip--blue { background: var(--blue-soft); color: var(--blue); }
.chip--slate { background: var(--slate-soft); color: var(--slate); }
.chip--orange { background: var(--orange-soft); color: var(--orange-strong); }
.chip--red { background: var(--red-soft); color: var(--red); }
.chip--purple { background: var(--purple-soft); color: var(--purple); }
.chip--green { background: var(--green-soft); color: var(--green); }
.status-badge { display: inline-flex; align-items: center; padding: 3px 10px; border-radius: 999px; font-size: .7rem; font-weight: 600; }
.status--draft { background: var(--yellow-soft); color: var(--yellow); }
.status--confirmed { background: var(--blue-soft); color: var(--blue); }
.status--approved { background: var(--green-soft); color: var(--green); }
.status--locked { background: var(--slate-soft); color: var(--slate); }
.status--ready { background: var(--purple-soft); color: var(--purple); }

/* ══════════════════════════════════════════════
   CREW PAYROLL WORKFLOW — the new centerpiece
══════════════════════════════════════════════ */

/* Phase indicator bar */
.workflow-phases {
  display: flex; align-items: center; gap: 0;
  padding: 14px 20px; border-bottom: 1px solid var(--border); background: #fafbfd;
  overflow-x: auto;
}
.phase {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 16px; border-radius: 8px; cursor: pointer;
  font-size: .8rem; font-weight: 600; color: var(--muted); white-space: nowrap;
  transition: all .15s;
}
.phase:hover { background: #f0f0f0; }
.phase.active { background: var(--orange-soft); color: var(--orange); }
.phase.done { color: var(--green); }
.phase-num {
  width: 22px; height: 22px; border-radius: 50%; border: 2px solid currentColor;
  display: flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 800; flex-shrink: 0;
}
.phase.done .phase-num { background: var(--green); border-color: var(--green); color: white; }
.phase.active .phase-num { background: var(--orange); border-color: var(--orange); color: white; }
.phase-arrow { color: #ccc; font-size: 1.1rem; margin: 0 4px; flex-shrink: 0; }

/* Crew accordion */
.crew-section { border-bottom: 1px solid var(--border); }
.crew-section:last-child { border-bottom: none; }
.crew-header {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 20px; cursor: pointer; transition: background .15s;
  user-select: none;
}
.crew-header:hover { background: #fafbfd; }
.crew-header.open { background: var(--orange-soft); border-bottom: 1px solid rgba(255,140,0,.2); }
.crew-chevron { font-size: .75rem; color: var(--muted); transition: transform .2s; flex-shrink: 0; }
.crew-chevron.open { transform: rotate(90deg); color: var(--orange); }
.crew-title { font-weight: 700; font-size: .95rem; flex: 1; }
.crew-meta { font-size: .75rem; color: var(--muted); }
.crew-badges { display: flex; gap: 6px; flex-wrap: wrap; }
.crew-body { display: none; }
.crew-body.open { display: block; }

/* Mini employee row (compact, good for 10 people) */
.emp-row {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 20px; border-bottom: 1px solid #f0f3f9;
  font-size: .82rem; transition: background .12s; cursor: pointer;
}
.emp-row:last-child { border-bottom: none; }
.emp-row:hover { background: #fafbfd; }
.emp-row.selected { background: var(--orange-soft); }
.emp-avatar {
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: .72rem; font-weight: 800; color: white; flex-shrink: 0;
}
.emp-row-name { font-weight: 600; width: 130px; flex-shrink: 0; }
.emp-row-hours { width: 55px; font-weight: 700; flex-shrink: 0; }
.emp-row-status { width: 130px; flex-shrink: 0; }
.emp-row-net { font-weight: 800; color: var(--orange); width: 90px; flex-shrink: 0; }
.emp-row-type { width: 50px; flex-shrink: 0; }
.emp-row-check { flex: 1; }
.days-mini { display: flex; gap: 3px; }
.day-dot {
  width: 20px; height: 20px; border-radius: 4px; border: 1px solid var(--border);
  display: flex; align-items: center; justify-content: center;
  font-size: .58rem; font-weight: 700; color: var(--muted); background: #fafbfd;
}
.day-dot--filled { background: var(--orange-soft); border-color: var(--orange); color: var(--orange-strong); }
.day-dot--confirmed { background: var(--green-soft); border-color: var(--green); color: var(--green); }
.day-dot--off { opacity: .35; }

/* Crew payroll summary footer */
.crew-payroll-footer {
  padding: 14px 20px; background: #fafbfd; border-top: 2px solid var(--border);
  display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
}
.crew-totals { display: flex; gap: 20px; flex-wrap: wrap; }
.crew-total-item { display: flex; flex-direction: column; gap: 2px; }
.crew-total-item span { font-size: .68rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; }
.crew-total-item strong { font-size: 1rem; font-weight: 800; color: var(--dark); }
.crew-total-item.big strong { font-size: 1.2rem; color: var(--orange); }

/* Handshake / approve button */
.crew-approve-btn {
  padding: 10px 22px; background: var(--green); color: white; border: none;
  border-radius: 10px; font-size: .9rem; font-weight: 700; cursor: pointer;
  display: flex; align-items: center; gap: 8px; transition: all .15s; white-space: nowrap;
}
.crew-approve-btn:hover { background: #1a6040; transform: translateY(-1px); box-shadow: 0 4px 14px rgba(36,122,77,.3); }
.crew-approve-btn.approved { background: var(--slate); cursor: default; }
.crew-approve-btn.approved:hover { transform: none; box-shadow: none; background: var(--slate); }

/* ── Payroll Handoff section ── */
.handoff-section {
  padding: 20px; display: grid; gap: 14px;
}
.handoff-card {
  border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
  transition: box-shadow .15s; cursor: pointer;
}
.handoff-card:hover { box-shadow: var(--shadow-lg); }
.handoff-card-header {
  padding: 14px 16px; display: flex; align-items: center; gap: 12px;
  border-bottom: 1px solid var(--border); background: #fafbfd;
}
.handoff-icon {
  width: 40px; height: 40px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;
}
.handoff-card-body { padding: 14px 16px; }
.handoff-title { font-weight: 700; font-size: .92rem; }
.handoff-desc { font-size: .78rem; color: var(--muted); margin-top: 2px; }
.handoff-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }

.csv-preview {
  font-family: ui-monospace, monospace; font-size: .72rem; background: #1e1e2e;
  color: #cdd6f4; border-radius: 8px; padding: 12px 14px; overflow-x: auto;
  line-height: 1.6; margin-top: 10px;
}
.csv-preview .csv-header { color: #89dceb; font-weight: 700; }
.csv-preview .csv-row { color: #a6e3a1; }

/* ── Week context bar ── */
.week-context-row { display: flex; align-items: center; gap: 10px; margin-top: 6px; flex-wrap: wrap; }
.week-chip { padding: 3px 10px; border-radius: 999px; font-size: .7rem; font-weight: 700; background: var(--green-soft); color: var(--green); }
.week-note { font-size: .75rem; color: var(--muted); }

/* ── Team table ── */
.team-table { width: 100%; border-collapse: collapse; font-size: .83rem; }
.team-table th { text-align: left; padding: 10px 14px; font-size: .68rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid var(--border); background: #fafbfd; }
.team-table td { padding: 11px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
.team-table tr:last-child td { border-bottom: none; }
.team-table tr:hover td { background: #fafbfd; }
.avatar { width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: .68rem; color: white; flex-shrink: 0; }
.emp-cell { display: flex; align-items: center; gap: 9px; }

/* ── Truck view ── */
.strip-btn { padding: 8px 14px; border: 1.5px solid var(--border); border-radius: 10px; background: white; cursor: pointer; text-align: left; min-width: 110px; transition: all .15s; font-size: .8rem; }
.strip-btn.active { border-color: var(--orange); background: var(--orange-soft); }
.strip-btn strong { display: block; font-size: .82rem; font-weight: 700; }
.strip-btn span { font-size: .7rem; color: var(--muted); }
.strip-btn em { display: block; font-style: normal; font-size: .65rem; color: var(--muted); margin-top: 2px; }
.day-tab { padding: 8px 14px; border: 1.5px solid var(--border); border-bottom: none; border-radius: 8px 8px 0 0; background: #f5f5f5; cursor: pointer; font-size: .8rem; font-weight: 600; color: var(--muted); transition: all .15s; }
.day-tab.active { background: white; border-color: var(--orange); color: var(--dark); }
.day-tab.today { color: var(--blue); }
.time-field { display: flex; flex-direction: column; gap: 4px; font-size: .8rem; font-weight: 600; color: var(--muted); }
.time-field input[type="time"] { padding: 10px 12px; border: 2px solid var(--border); border-radius: 8px; font-size: 1rem; font-weight: 700; color: var(--dark); background: white; cursor: pointer; width: 130px; }
.time-field input[type="time"]:focus { border-color: var(--orange); outline: none; }
.adj-btn { padding: 8px 14px; border: 1.5px solid var(--border); border-radius: 8px; background: white; font-size: .78rem; font-weight: 700; cursor: pointer; color: var(--dark); }
.adj-btn:hover { background: var(--orange-soft); border-color: var(--orange); }
.confirm-strip { background: var(--green-soft); border: 1px solid var(--green); border-radius: 10px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; font-size: .85rem; }
.btn-confirm { background: var(--green); color: white; border: none; border-radius: 8px; padding: 8px 18px; font-weight: 700; cursor: pointer; }

/* ── Pages ── */
.page { display: none; }
.page.active { display: block; }

/* ── Missing time banner ── */
.missing-banner { background: rgba(255,140,0,0.06); border-left: 4px solid var(--orange); padding: 12px 18px; border-radius: 0 8px 8px 0; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }

/* ── Mobile employee view ── */
.employee-view { max-width: 420px; margin: 0 auto; }
.employee-header { background: var(--dark); color: white; padding: 20px 16px 12px; border-radius: var(--radius) var(--radius) 0 0; }
.employee-header .eyebrow { color: var(--teal); }
.employee-header h2 { font-size: 1.3rem; font-weight: 800; margin: 4px 0; }
.emp-week-label { font-size: .78rem; color: #aaa; }
.emp-days-scroll { display: flex; gap: 8px; padding: 12px 16px; overflow-x: auto; }
.emp-day-btn { min-width: 58px; border: 1.5px solid var(--border); border-radius: 10px; padding: 8px 6px; text-align: center; cursor: pointer; background: white; font-size: .72rem; flex-shrink: 0; transition: all .15s; }
.emp-day-btn.today { border-color: var(--blue); background: var(--blue-soft); }
.emp-day-btn.active { border-color: var(--orange); background: var(--orange-soft); }
.emp-day-btn .day-h { font-size: .82rem; font-weight: 800; color: var(--orange); margin-top: 4px; }
.emp-time-entry { padding: 16px; border: 1px solid var(--border); border-radius: 0 0 var(--radius) var(--radius); background: white; }
.big-time-display { text-align: center; padding: 20px; background: var(--dark); border-radius: 12px; margin-bottom: 14px; }
.big-time-display .time-val { font-size: 2.5rem; font-weight: 900; color: white; letter-spacing: .05em; }
.big-time-display .time-sub { font-size: .8rem; color: #aaa; margin-top: 4px; }
.tap-adjust { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 14px; }
.tap-btn { padding: 14px; border: 1.5px solid var(--border); border-radius: 10px; background: white; font-size: .85rem; font-weight: 700; cursor: pointer; text-align: center; transition: all .15s; }
.tap-btn .tap-label { font-size: .68rem; color: var(--muted); font-weight: 500; margin-bottom: 4px; }
.tap-btn:hover { background: var(--orange-soft); border-color: var(--orange); }

/* ── Annotations ── */
.annotation {
  background: #fffbe6; border: 1px solid #f5d020; border-radius: 8px;
  padding: 8px 12px; font-size: .76rem; color: #7a5900; margin: 8px 20px;
  display: flex; gap: 8px; align-items: flex-start;
}
.annotation::before { content: "💬"; flex-shrink: 0; }

/* ── Select ── */
select.sel { padding: 7px 10px; border: 1.5px solid var(--border); border-radius: 8px; font-size: .82rem; background: white; cursor: pointer; }

@media (max-width: 700px) {
  .emp-row-hours, .emp-row-type, .emp-row-check, .days-mini { display: none; }
  .handoff-grid { grid-template-columns: 1fr; }
  .crew-totals { gap: 12px; }
  .stats-row { flex-direction: column; }
}
</style>
</head>
