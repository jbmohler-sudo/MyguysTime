interface TeamManagementPanelProps {
  data: BootstrapPayload;
  onOpenAddEmployee: () => void;
  onEditEmployee: (employee: ManagedEmployee) => void;
}

export function TeamManagementPanel({
  data,
  onOpenAddEmployee,
  onEditEmployee,
