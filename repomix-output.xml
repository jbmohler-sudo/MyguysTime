                  <p
                    style={{
                      margin: "4px 0 0 0",
                      fontSize: "12px",
                      color: STATUS_GRAY,
                    }}
                  >
                    {emp.crew} • ${emp.rate.toFixed(2)}/hr
                  </p>
                </div>

                {/* Status Badge */}
