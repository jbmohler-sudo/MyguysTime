              type="button"
              aria-busy={isExporting}
              style={{
                padding: "10px 24px",
                borderRadius: "6px",
                border: "none",
                backgroundColor: qboPreview?.isReady ? BRAND_ORANGE : "#ccc",
                color: "white",
                fontSize: "14px",
                fontWeight: 600,
