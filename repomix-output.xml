<script>
// ── Role switcher ──
function switchRole(role) {
  document.querySelectorAll('.view').forEach(v => v.style.display = 'none');
  document.getElementById('view-' + role).style.display = 'block';
  document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('btn-' + role).classList.add('active');
}

// ── Admin nav tabs ──
function adminTab(page, btn) {
  document.querySelectorAll('#view-admin .page').forEach(p => p.classList.remove('active'));
  document.getElementById('admin-' + page).classList.add('active');
  document.querySelectorAll('#view-admin .nav-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// ── Crew accordion ──
function toggleCrew(name) {
  const body = document.getElementById('body-' + name);
  const chevron = document.getElementById('chevron-' + name);
  const header = body.previousElementSibling;
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open', !isOpen);
  chevron.classList.toggle('open', !isOpen);
  header.classList.toggle('open', !isOpen);
}

// ── Crew approval ──
const approved = { masonry: false, framing: false, electric: false };
function approveCrew(name, e) {
  e.stopPropagation();
  if (approved[name]) return;
  approved[name] = true;

  // Update approve button
  const btn = document.getElementById('approve-' + name);
  btn.classList.add('approved');
  btn.textContent = '✓ ' + name.charAt(0).toUpperCase() + name.slice(1) + ' — Approved';

  // Update crew status chip
  const statusEl = document.getElementById(name + '-status');
  statusEl.className = 'status-badge status--ready';
  statusEl.textContent = 'Approved for payroll';

  // Update modal
  const modalEl = document.getElementById('modal-' + name);
  if (modalEl) { modalEl.className = 'status-badge status--ready'; modalEl.textContent = 'Approved'; }

  // Update workflow phases
  const allApproved = approved.masonry && approved.framing && approved.electric;
  const anyApproved = approved.masonry || approved.framing || approved.electric;

  if (anyApproved) {
    document.getElementById('phase-2').classList.add('active');
  }

  // Update ready count
  const readyCount = Object.values(approved).filter(Boolean).length;
  document.getElementById('ready-count').textContent = readyCount + ' / 3';

  if (allApproved) {
    // Unlock export button
    const exportBtn = document.getElementById('export-all-btn');
    exportBtn.disabled = false;
    exportBtn.style.opacity = '1';
    exportBtn.style.cursor = 'pointer';

    // Phase 3 active
    document.getElementById('phase-3').classList.add('active');
    document.getElementById('modal-crew-count').textContent = 'All 3 crews approved. Ready to export.';

    // Brief flash on export button
    exportBtn.style.background = 'var(--green)';
    setTimeout(() => { exportBtn.style.background = ''; }, 1200);
  }
}

// ── Filter crew visibility ──
function filterCrew(value) {
  const crews = ['masonry', 'framing', 'electric'];
  crews.forEach(c => {
    const el = document.getElementById('crew-' + c);
    el.style.display = (value === 'all' || value === c) ? '' : 'none';
  });
}

// ── Payroll modal ──
function showPayrollModal() {
  const modal = document.getElementById('payroll-modal');
  modal.style.display = 'flex';
}
document.getElementById('payroll-modal').addEventListener('click', function(e) {
  if (e.target === this) this.style.display = 'none';
});

// ── Foreman helpers ──
function foremanSelectEmp(btn) {
  document.querySelectorAll('.strip-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}
function selectDay(btn) {
  document.querySelectorAll('.day-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// ── Time adjust ──
function adjustTime(field, minutes) {
  const id = field === 'start' ? 'truck-start' : 'truck-end';
  const input = document.getElementById(id);
  if (!input) return;
  const [h, m] = input.value.split(':').map(Number);
  const total = Math.max(0, Math.min(23*60+59, h*60 + m + minutes));
  input.value = String(Math.floor(total/60)).padStart(2,'0') + ':' + String(total%60).padStart(2,'0');
  recalcHours();
}
function recalcHours() {
  const s = document.getElementById('truck-start')?.value;
  const e = document.getElementById('truck-end')?.value;
  if (!s || !e) return;
  const [sh,sm] = s.split(':').map(Number);
  const [eh,em] = e.split(':').map(Number);
  const hrs = Math.max(0, ((eh*60+em) - (sh*60+sm) - 30) / 60).toFixed(1);
  const el = document.getElementById('truck-hours-calc');
  if (el) el.textContent = hrs + 'h';
}
</script>
</body>
</html>
