<file path="prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(cuid())
  supabaseId     String?         @unique @db.Uuid
  companyId      String
  email          String          @unique
  phone          String?
  fullName       String
  role           String
  employeeId     String?         @unique
  status         String          @default("ACTIVE")
  invitedAt      DateTime?
  acceptedAt     DateTime?
  deactivatedAt  DateTime?
  preferredView  String          @default("office")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee       Employee?       @relation(fields: [employeeId], references: [id])
  sentInvites    UserInvite[]    @relation("UserInvitesSent")
  createdReports PrivateReport[] @relation("PrivateReportAuthor")
  payrollExports PayrollExport[] @relation("PayrollExportByUser")
  submittedExpenses ExpenseSubmission[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([companyId])
}

model Company {
  id                           String                 @id @default(cuid())
  companyName                  String
  ownerName                    String?
  stateCode                    String
  onboardingCompletedAt        DateTime?
  onboardingCompletedByUserId  String?
  payrollDisclaimerAcceptedAt  DateTime?
  payrollDisclaimerAcceptedByUserId String?
  payrollDisclaimerVersion     String?
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  payrollSettings              CompanyPayrollSettings?
  users                        User[]
  crews                        Crew[]
  employees                    Employee[]
  userInvites                  UserInvite[]
  payrollExports               PayrollExport[]
  expenseSubmissions           ExpenseSubmission[]
}

model Crew {
  id           String           @id @default(cuid())
  companyId    String
  name         String
  foremanId    String?
  foreman      Employee?        @relation("ForemanCrew", fields: [foremanId], references: [id])
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultEmployees Employee[]   @relation("DefaultCrew")
  assignments  CrewAssignment[]
  dayDefaults  CrewDayDefault[]
  timesheets   TimesheetWeek[]
  reports      PrivateReport[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([companyId])
}

model Employee {
  id                String             @id @default(cuid())
  companyId         String
  firstName         String
  lastName          String
  displayName       String
  workerType        String             @default("EMPLOYEE")
  employmentStatus  String             @default("ACTIVE")
  hourlyRateCents   Int
  overtimeRateCents Int?
  federalFilingStatus String           @default("single")
  w4Step3Amount     Float              @default(0)
  w4CollectedAt     DateTime?
  usesCompanyFederalDefault Boolean    @default(true)
  usesCompanyStateDefault   Boolean    @default(true)
  federalWithholdingPercent Float      @default(0.10)
  stateWithholdingPercent   Float      @default(0.03)
  defaultCrewId     String?
  archiveReason     String?
  archiveNotes      String?
  archivedAt        DateTime?
  rehiredAt         DateTime?
  user              User?
  userInvites       UserInvite[]
  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultCrew       Crew?              @relation("DefaultCrew", fields: [defaultCrewId], references: [id])
  foremanForCrew    Crew[]             @relation("ForemanCrew")
  assignments       CrewAssignment[]
  timesheets        TimesheetWeek[]
  adjustments       WeeklyAdjustment[]
  payrollEstimates  PayrollEstimate[]
  reports           PrivateReport[]
  expenseSubmissions ExpenseSubmission[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId])
}

model UserInvite {
  id              String    @id @default(cuid())
  companyId       String
  employeeId      String?
  email           String?
  phone           String?
  role            String
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  lastSentAt      DateTime?
  sendCount       Int       @default(0)
  invitedByUserId String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  invitedByUser   User      @relation("UserInvitesSent", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([employeeId])
  @@index([invitedByUserId])
}

model CompanyPayrollSettings {
  id                             String   @id @default(cuid())
  companyId                      String   @unique
  defaultFederalWithholdingMode  String   @default("PERCENTAGE")
  defaultFederalWithholdingValue Float    @default(0.10)
  defaultStateWithholdingMode    String   @default("PERCENTAGE")
  defaultStateWithholdingValue   Float    @default(0.03)
  timeTrackingStyle             String   @default("FOREMAN")
  weekStartDay                  Int      @default(1)
  defaultLunchMinutes           Int      @default(30)
  payType                       String   @default("HOURLY_OVERTIME")
  payrollMethod                 String   @default("MANUAL")
  trackExpenses                 Boolean  @default(true)
  payrollPrepDisclaimer          String?
  pfmlEnabled                    Boolean  @default(false)
  pfmlEmployeeRate               Float    @default(0)
  extraWithholdingLabel          String?
  extraWithholdingRate           Float?
  supportLevelSnapshot           String   @default("PARTIAL_MANUAL")
  company                        Company  @relation(fields: [companyId], references: [id])
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model StatePayrollRule {
  id                           String   @id @default(cuid())
  stateCode                    String   @unique
  stateName                    String
  supportLevel                 String
  hasStateIncomeTax            Boolean  @default(true)
  hasExtraEmployeeWithholdings Boolean  @default(false)
  extraWithholdingTypes        String?
  defaultStateWithholdingMode  String   @default("PERCENTAGE")
  defaultStateWithholdingValue Float    @default(0)
  defaultPfmlEnabled           Boolean  @default(false)
  defaultPfmlEmployeeRate      Float    @default(0)
  notes                        String?
  disclaimerText               String?
  lastReviewedAt               DateTime?
  sourceLabel                  String?
  sourceUrl                    String?
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model CrewAssignment {
  id         String   @id @default(cuid())
  crewId     String
  employeeId String
  startsOn   DateTime
  endsOn     DateTime?
  crew       Crew     @relation(fields: [crewId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id])
  createdAt  DateTime @default(now())

  @@index([crewId, startsOn])
  @@index([employeeId, startsOn])
}

model CrewDayDefault {
  id               String   @id @default(cuid())
  crewId           String
  weekStartDate    DateTime
  dayIndex         Int
  startTimeMinutes Int?
  endTimeMinutes   Int?
  crew             Crew     @relation(fields: [crewId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([crewId, weekStartDate, dayIndex])
}

model TimesheetWeek {
  id                    String          @id @default(cuid())
  employeeId            String
  crewId                String
  weekStartDate         DateTime
  status                String          @default("DRAFT")
  submittedByEmployeeAt DateTime?
  reviewedByForemanAt   DateTime?
  lockedAt              DateTime?
  exportedAt            DateTime?
  exportedByUserId      String?
  employee              Employee        @relation(fields: [employeeId], references: [id])
  crew                  Crew            @relation(fields: [crewId], references: [id])
  dayEntries            TimeEntryDay[]
  adjustment            WeeklyAdjustment?
  expenseSubmissions    ExpenseSubmission[]
  payrollEstimate       PayrollEstimate?
  statusAuditEvents     TimesheetStatusAudit[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@unique([employeeId, weekStartDate])
  @@index([crewId, weekStartDate])
}

model TimesheetStatusAudit {
  id              String        @id @default(cuid())
  timesheetWeekId String
  fromStatus      String
  toStatus        String
  note            String?
  createdByUserId String
  createdAt       DateTime      @default(now())
  timesheetWeek   TimesheetWeek @relation(fields: [timesheetWeekId], references: [id])
}

model TimeEntryDay {
  id                String        @id @default(cuid())
  timesheetWeekId   String
  dayIndex          Int
  workDate          DateTime
  startTimeMinutes  Int?
  endTimeMinutes    Int?
  lunchMinutes      Int           @default(0)
  totalMinutes      Int           @default(0)
  jobTag            String?
  employeeConfirmed Boolean       @default(false)
  timesheetWeek     TimesheetWeek @relation(fields: [timesheetWeekId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([timesheetWeekId, dayIndex])
}

model WeeklyAdjustment {
  id                    String        @id @default(cuid())
  employeeId            String
  timesheetWeekId       String        @unique
  gasReimbursementCents Int           @default(0)
  pettyCashCents        Int           @default(0)
  deductionCents        Int           @default(0)
  note                  String?
  employee              Employee      @relation(fields: [employeeId], references: [id])
  timesheetWeek         TimesheetWeek @relation(fields: [timesheetWeekId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model ExpenseSubmission {
  id               String        @id @default(cuid())
  companyId        String
  employeeId       String
  timesheetWeekId  String
  category         String
  amountCents      Int
  note             String?
  hasReceipt       Boolean       @default(false)
  submittedByUserId String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee         Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  timesheetWeek    TimesheetWeek @relation(fields: [timesheetWeekId], references: [id], onDelete: Cascade)
  submittedByUser  User          @relation(fields: [submittedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, timesheetWeekId])
  @@index([employeeId, createdAt])
  @@index([submittedByUserId])
}

model PayrollEstimate {
  id                      String          @id @default(cuid())
  employeeId              String
  timesheetWeekId         String          @unique
  regularMinutes          Int
  overtimeMinutes         Int
  grossPayCents           Int
  federalWithholdingMode  String          @default("PERCENTAGE")
  federalWithholdingValue Float
  stateWithholdingMode    String          @default("PERCENTAGE")
  stateWithholdingValue   Float
  federalWithholdingCents Int
  stateWithholdingCents   Int
  pfmlWithholdingCents    Int             @default(0)
  extraStateWithholdingLabel String?
  extraStateWithholdingCents Int          @default(0)
  manualNetOverrideCents  Int?
  netCheckEstimateCents   Int
  employee                Employee        @relation(fields: [employeeId], references: [id])
  timesheetWeek           TimesheetWeek   @relation(fields: [timesheetWeekId], references: [id])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model PrivateReport {
  id                 String         @id @default(cuid())
  employeeId         String
  crewId             String
  reportDate         DateTime
  jobTag             String?
  category           String
  severity           String
  factualDescription String
  followUpStatus     String         @default("OPEN")
  createdByUserId    String
  employee           Employee       @relation(fields: [employeeId], references: [id])
  crew               Crew           @relation(fields: [crewId], references: [id])
  createdByUser      User           @relation("PrivateReportAuthor", fields: [createdByUserId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([employeeId, reportDate])
  @@index([crewId, reportDate])
}

model PayrollExport {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  weekStart        String
  exportKind       String   @default("qbo")
  totalRows        Int
  totalHours       Float
  fileName         String
  exportedByUserId String
  exportedByUser   User     @relation("PayrollExportByUser", fields: [exportedByUserId], references: [id])
  exportedAt       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([exportedAt])
}
