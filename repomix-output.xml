  display: grid;
  gap: 0.85rem;
  margin-bottom: 1rem;
  padding: 1rem;
}

.settings-section__header {
  align-items: start;
  display: flex;
  gap: 0.75rem;
  justify-content: space-between;
}

.settings-form {
  margin-top: 0;
}

.settings-meta {
  color: var(--text-muted);
  font-size: 0.84rem;
  max-width: 28ch;
  text-align: right;
}

.settings-grid--tight {
  margin-bottom: 0;
}

.disclaimer-card {
  background: color-mix(in srgb, var(--color-bg-subtle) 45%, var(--color-bg-surface) 55%);
  border: 1px solid var(--color-border-default);
  border-radius: 18px;
  display: grid;
  gap: 0.45rem;
  margin-bottom: 1rem;
  padding: 1rem;
}

.disclaimer-card__header {
  align-items: start;
  display: flex;
  justify-content: space-between;
  gap: 0.75rem;
}

.disclaimer-card h2,
.disclaimer-card h3 {
  margin: 0 0 0.2rem;
}

.disclaimer-card__intro {
  color: var(--brand-dark);
  font-size: 0.9rem;
  font-weight: 700;
}

.disclaimer-copy {
  display: grid;
  gap: 0.45rem;
}

.disclaimer-card p {
  color: color-mix(in srgb, var(--color-text-primary) 88%, transparent);
}

.disclaimer-spacer {
  height: 0.35rem;
}

.checkbox-row--disclaimer {
  align-items: start;
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  font-size: 0.9rem;
  margin-top: 0.5rem;
  padding: 0.8rem 0.9rem;
}

.support-summary {
  background: color-mix(in srgb, var(--color-bg-subtle) 60%, var(--color-bg-surface) 40%);
  border: 1px solid var(--color-border-default);
  border-radius: 18px;
  display: grid;
  gap: 0.85rem;
  margin-bottom: 1rem;
  padding: 1rem;
}

.support-summary__header {
  align-items: start;
  display: flex;
  gap: 0.75rem;
  justify-content: space-between;
}

.support-pill {
  border-radius: var(--radius-pill);
  font-size: 0.82rem;
  font-weight: 700;
  padding: 0.45rem 0.8rem;
}

.support-pill--full {
  background: var(--color-support-full-soft);
  color: var(--success);
}

.support-pill--partial_manual {
  background: var(--color-support-manual-soft);
  color: var(--color-support-manual);
}

.support-pill--unsupported {
  background: var(--color-support-unsupported-soft);
  color: var(--color-support-unsupported);
}

.support-summary__grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.support-summary__grid div {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  display: grid;
  gap: 0.2rem;
  padding: 0.8rem 0.9rem;
}

.support-summary__grid span {
  color: var(--text-muted);
  font-size: 0.82rem;
}

.support-summary__explanation {
  color: color-mix(in srgb, var(--color-text-primary) 88%, transparent);
  font-weight: var(--font-weight-semibold);
}

.support-summary__disclaimer {
  color: var(--text-muted);
  font-size: 0.92rem;
}

.support-summary__source {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.support-summary__source a {
  color: var(--brand-dark);
}

.explainer-card {
  background: color-mix(in srgb, var(--color-status-info-soft) 40%, var(--color-bg-surface) 60%);
  border: 1px solid var(--color-border-default);
  border-radius: 18px;
  display: grid;
  gap: 0.85rem;
  margin-bottom: 1rem;
  padding: 1rem;
}

.explainer-grid {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.explainer-grid div {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  display: grid;
  gap: 0.3rem;
  padding: 0.85rem 0.9rem;
}

.explainer-grid strong {
  color: color-mix(in srgb, var(--color-text-primary) 92%, transparent);
}

.explainer-grid span {
  color: var(--text-muted);
  font-size: 0.88rem;
}

.adjustment-editor-wrap {
  display: grid;
  gap: 0.75rem;
}

.adjustment-editor__notes {
  grid-column: 1 / -1;
}

.adjustment-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.sentry-verification-panel {
  gap: 0.85rem;
}

.sentry-verification-panel__header {
  align-items: start;
  display: flex;
  gap: 0.75rem;
  justify-content: space-between;
}

.sentry-verification-panel__header span {
  color: var(--text-muted);
}

.sentry-verification-panel__actions {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.sentry-verification-card {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  display: grid;
  gap: 0.45rem;
  padding: 0.9rem;
}

.sentry-verification-card span {
  color: var(--text-muted);
  font-size: 0.9rem;
}

.audit-trail {
  display: grid;
  gap: 0.45rem;
}

.audit-row {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  display: grid;
  gap: 0.25rem;
  padding: 0.7rem 0.8rem;
}

.audit-row__headline {
  font-weight: 700;
}

.audit-row__note {
  color: color-mix(in srgb, var(--color-text-primary) 82%, transparent);
}

.reopen-panel {
  border-top: 1px solid color-mix(in srgb, var(--color-border-default) 72%, var(--color-bg-surface) 28%);
  display: grid;
  gap: 0.75rem;
  margin-top: 1rem;
  padding-top: 1rem;
}

.audit-summary {
  color: var(--text-muted);
  font-size: 0.85rem;
}

table {
  border-collapse: collapse;
  width: 100%;
}

/* Only enforce wide min-width when inside an explicitly scrollable wrapper */
.table-wrap table,
.invite-table {
  min-width: 900px;
}

th,
td {
  border-bottom: 1px solid color-mix(in srgb, var(--color-border-default) 75%, var(--color-bg-surface) 25%);
  padding: 0.85rem 0.65rem;
  text-align: left;
}

th {
  color: var(--text-muted);
  font-size: 0.84rem;
  text-transform: uppercase;
}

.report-card {
  background: color-mix(in srgb, var(--color-bg-subtle) 75%, var(--color-bg-surface) 25%);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 18px;
  display: grid;
  gap: 0.4rem;
  padding: 0.9rem;
}

.team-summary-grid,
.team-card__details {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.team-list {
  display: grid;
  gap: 0.9rem;
}

.team-card {
  gap: 0.8rem;
}

.team-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  justify-content: flex-end;
}

.team-card__meta,
.team-card__details {
  display: grid;
  gap: 0.6rem;
}

.team-card__meta {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.team-card__meta span,
.team-card__details span {
  color: var(--text-muted);
  font-size: var(--text-sm);
}

.team-card__details strong {
  color: var(--color-text-primary);
  display: block;
  margin-top: 0.15rem;
}

.team-editor {
  margin: 1rem 0;
}

.team-invites-section {
  margin-top: 1rem;
}

.invite-status {
  border-radius: var(--radius-pill);
  font-size: 0.8rem;
  font-weight: var(--font-weight-bold);
  padding: 0.35rem 0.7rem;
  text-transform: capitalize;
}

.invite-status--pending {
  background: var(--color-status-info-soft);
  color: var(--brand-dark);
}

.invite-status--accepted {
  background: var(--color-status-success-soft);
  color: var(--success);
}

.invite-status--expired {
  background: color-mix(in srgb, var(--color-bg-subtle) 70%, var(--color-bg-surface) 30%);
  color: var(--text-muted);
}

.invite-link-banner {
  gap: 0.7rem;
}

.invite-link-banner a {
  color: var(--brand-dark);
  font-weight: var(--font-weight-semibold);
}

.empty-state {
  color: var(--text-muted);
  padding: 1rem 0;
}

.error-banner {
  background: var(--color-status-danger-soft);
  border: 1px solid color-mix(in srgb, var(--color-status-danger) 24%, var(--color-bg-surface) 76%);
  border-radius: 14px;
  color: var(--danger);
  margin-bottom: 1rem;
  padding: 0.85rem 1rem;
}

.loading-screen {
  align-items: center;
  display: grid;
  min-height: 100vh;
  place-items: center;
}

.marketing-shell {
  background:
    radial-gradient(circle at top right, color-mix(in srgb, var(--color-brand-primary-soft) 75%, transparent) 0%, transparent 32%),
    linear-gradient(180deg, var(--color-bg-app) 0%, var(--color-bg-surface) 100%);
  min-height: 100vh;
  padding: var(--space-16);
}

.marketing-hero,
.marketing-main {
  margin: 0 auto;
  max-width: var(--width-content-xl);
}

.marketing-header {
  margin: 0 auto;
  max-width: var(--width-content-xl);
  padding: 0 0 var(--space-8);
}

.marketing-hero {
  align-items: center;
  display: grid;
  gap: var(--space-24);
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  padding: var(--space-24) 0 var(--space-20);
}

.marketing-hero__copy {
  display: grid;
  gap: var(--space-16);
}

.marketing-hero h1,
.marketing-section h2 {
  color: var(--color-text-primary);
  letter-spacing: -0.04em;
}

.marketing-hero h1 {
  font-size: clamp(2.25rem, 5vw, 4.25rem);
  line-height: 1;
  max-width: 12ch;
}

.marketing-lead,
.marketing-section p,
.marketing-feature-list li {
  color: var(--color-text-secondary);
  font-size: var(--text-lg);
}

.marketing-actions {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-12);
}

.marketing-link-button {
  display: inline-flex;
  text-decoration: none;
}

.marketing-link {
  color: var(--color-brand-primary-strong);
  font-weight: var(--font-weight-semibold);
  text-decoration: none;
}

.marketing-note {
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
  max-width: 58ch;
}

.marketing-main {
  display: grid;
  gap: var(--space-24);
  padding-bottom: var(--space-40);
}

.marketing-section {
  background: color-mix(in srgb, var(--color-bg-surface) 88%, transparent);
  border: 1px solid var(--color-border-default);
  border-radius: 24px;
  box-shadow: var(--shadow-sm);
  display: grid;
  gap: var(--space-16);
  padding: var(--space-24);
}

.marketing-section--bridge,
.marketing-section--trust {
  background: color-mix(in srgb, var(--color-brand-primary-soft) 22%, var(--color-bg-surface) 78%);
}

.marketing-steps {
  display: grid;
  gap: var(--space-16);
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.marketing-step,
.marketing-card {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 82%, var(--color-bg-surface) 18%);
  border-radius: 18px;
  display: grid;
  gap: var(--space-8);
  padding: var(--space-16);
}

.marketing-step span {
  color: var(--color-brand-primary);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-bold);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.marketing-step h3,
.marketing-card h3 {
  color: var(--color-text-primary);
  font-size: var(--text-xl);
}

.marketing-step p,
.marketing-card p {
  color: var(--color-text-secondary);
  font-size: var(--text-md);
}

.marketing-columns {
  display: grid;
  gap: var(--space-16);
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.marketing-feature-list {
  display: grid;
  gap: var(--space-12);
  grid-template-columns: repeat(2, minmax(0, 1fr));
  list-style: none;
  margin: 0;
  padding: 0;
}

.marketing-feature-list li {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 82%, var(--color-bg-surface) 18%);
  border-radius: 16px;
  font-size: var(--text-md);
  padding: var(--space-16);
}

.homepage-shot {
  background: linear-gradient(180deg, color-mix(in srgb, var(--color-bg-surface) 92%, transparent) 0%, var(--color-bg-surface) 100%);
  border: 1px solid var(--color-border-default);
  border-radius: 28px;
  box-shadow: var(--shadow-lg);
  display: grid;
  gap: var(--space-16);
  overflow: hidden;
  padding: var(--space-20);
}

.homepage-shot__topbar,
.homepage-shot__card-header,
.homepage-shot__footer {
  align-items: center;
  display: flex;
  gap: var(--space-12);
  justify-content: space-between;
}

.homepage-shot__badge {
  background: var(--color-status-success-soft);
  border-radius: var(--radius-pill);
  color: var(--color-status-success);
  font-size: var(--text-sm);
  font-weight: var(--font-weight-bold);
  padding: 0.4rem 0.75rem;
}

.homepage-shot__stats {
  display: grid;
  gap: var(--space-12);
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.homepage-shot__stats div,
.homepage-shot__card {
  background: color-mix(in srgb, var(--color-bg-subtle) 70%, var(--color-bg-surface) 30%);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 18px;
  display: grid;
  gap: var(--space-8);
  padding: var(--space-16);
}

.homepage-shot__stats span,
.homepage-shot__card span,
.homepage-shot__day span,
.homepage-shot__day small {
  color: var(--color-text-secondary);
}

.homepage-shot__stats strong,
.homepage-shot__card strong,
.homepage-shot__day strong {
  color: var(--color-text-primary);
}

.homepage-shot__board {
  display: grid;
  gap: var(--space-16);
}

.homepage-shot__days {
  display: grid;
  gap: var(--space-8);
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.homepage-shot__day {
  background: var(--color-bg-surface);
  border: 1px solid color-mix(in srgb, var(--color-border-default) 78%, var(--color-bg-surface) 22%);
  border-radius: 14px;
  display: grid;
  gap: var(--space-4);
  padding: 0.7rem;
}

.homepage-shot__day--today {
  background: var(--color-today-bg);
  border-color: var(--color-today-border);
}

.homepage-shot__footer {
  align-items: flex-start;
}

.homepage-shot__card--secondary {
  background: linear-gradient(180deg, color-mix(in srgb, var(--color-brand-primary-soft) 42%, var(--color-bg-surface) 58%) 0%, var(--color-bg-surface) 100%);
}

.homepage-shot__list {
  display: grid;
  gap: var(--space-8);
  margin: 0;
  padding-left: 1.1rem;
}

.homepage-shot__list li {
  color: var(--color-text-secondary);
}

@media (max-width: 1100px) {
  .hero {
    flex-direction: column;
  }

  .marketing-hero,
  .marketing-steps,
  .marketing-columns,
  .marketing-feature-list {
    grid-template-columns: 1fr;
  }

  .magic-login-grid {
    grid-template-columns: 1fr;
  }

  .preview-role-switcher__actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .preview-role-switcher__button {
    padding-inline: 0.35rem;
  }

  .homepage-shot__stats {
    grid-template-columns: 1fr 1fr 1fr;
  }

  .setup-progress {
    grid-template-columns: 1fr 1fr;
  }

  .day-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats-row {
    grid-template-columns: 1fr;
  }

  .payroll-ytd-grid,
  .ytd-summary-grid {
    grid-template-columns: 1fr;
  }

  .adjustment-editor {
    grid-template-columns: 1fr 1fr;
  }

  .settings-grid {
    grid-template-columns: 1fr 1fr;
  }

  .company-summary-grid {
    grid-template-columns: 1fr 1fr;
  }

  .support-summary__grid {
    grid-template-columns: 1fr 1fr;
  }

  .explainer-grid {
    grid-template-columns: 1fr 1fr;
  }

  .sentry-verification-panel__actions {
    grid-template-columns: 1fr;
  }

  .employee-card__metrics,
  .office-week-card__summary {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 720px) {
  .app-shell {
    padding: 0;
  }

  .marketing-shell {
    padding: var(--space-12);
  }

  .marketing-hero {
    gap: var(--space-20);
    padding-top: 0;
  }

  .marketing-hero h1 {
    max-width: none;
  }

  .marketing-actions {
    align-items: stretch;
    flex-direction: column;
  }

  .marketing-link-button {
    justify-content: center;
  }

  .marketing-feature-list {
    grid-template-columns: 1fr;
  }

  .magic-login-grid {
    grid-template-columns: 1fr;
  }

  .homepage-shot {
    padding: var(--space-16);
  }

  .homepage-shot__topbar,
  .homepage-shot__card-header,
  .homepage-shot__footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .homepage-shot__stats,
  .homepage-shot__days {
    grid-template-columns: 1fr;
  }

  .day-grid {
    grid-template-columns: 1fr;
  }

  .panel__header,
  .employee-card__header,
  .employee-card__footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .hero__topbar {
    flex-direction: column;
  }

  .logo--app .logo__image {
    height: 44px;
  }

  .logo--marketing .logo__image,
  .logo--preview .logo__image {
    height: 32px;
  }

  .nav-toggle {
    min-height: 44px;
    padding: 10px 16px;
  }

  .app-nav {
    align-items: stretch;
    flex-direction: column;
  }

  .app-nav--mobile {
    display: none;
  }

  .app-nav--open {
    display: grid;
  }

  .crew-defaults,
  .hero-meta {
    align-items: stretch;
    flex-direction: column;
  }

  .adjustment-editor {
    grid-template-columns: 1fr;
  }

  .settings-grid {
    grid-template-columns: 1fr;
  }

  .company-summary-grid {
    grid-template-columns: 1fr;
  }

  .setup-progress {
    grid-template-columns: 1fr;
  }

  .support-summary__header {
    flex-direction: column;
  }

  .settings-section__header {
    flex-direction: column;
  }

  .sentry-verification-panel__header {
    flex-direction: column;
  }

  .settings-meta {
    max-width: none;
    text-align: left;
  }

  .support-summary__grid {
    grid-template-columns: 1fr;
  }

  .explainer-grid {
    grid-template-columns: 1fr;
  }

  .team-summary-grid,
  .team-card__meta,
  .team-card__details {
    grid-template-columns: 1fr;
  }

  .team-card__actions {
    justify-content: stretch;
  }

  .team-card__actions button {
    width: 100%;
  }

  .setup-employee-row {
    grid-template-columns: 1fr;
  }

  .auth-switch {
    align-items: stretch;
    flex-direction: column;
  }

  .truck-week-actions {
    width: 100%;
  }

  .truck-week-actions .button-strong,
  .truck-week-actions button {
    width: 100%;
  }

  .employee-card--truck .truck-week-actions {
    display: grid;
    gap: 0.45rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 0.65rem;
    padding-top: 0.1rem;
  }

  .employee-card--truck .truck-week-actions .button-strong,
  .employee-card--truck .truck-week-actions button {
    width: 100%;
  }

  .employee-card__metrics,
  .office-week-card__summary {
    grid-template-columns: 1fr;
  }

  .employee-card__workflow {
    justify-items: start;
    min-width: 0;
  }

  .employee-card__workflow-hint {
    max-width: none;
    text-align: left;
  }

  .employee-card--truck {
    padding: 0.62rem;
  }

  .employee-card--truck .employee-card__header {
    gap: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .employee-card--truck .employee-card__alerts {
    margin-bottom: 0.3rem;
  }

  .workflow-banner--truck-compact {
    margin-bottom: 0.32rem;
    padding: 0.4rem 0.52rem;
  }

  .workflow-banner--truck-compact strong {
    font-size: 0.72rem;
  }

  .workflow-banner--truck-compact span {
    font-size: 0.68rem;
  }

  .truck-day-nav {
    gap: 0.24rem;
    grid-auto-columns: minmax(64px, 1fr);
  }

  .truck-day-nav__button {
    padding: 0.38rem 0.5rem;
  }

  .truck-day-nav__button span {
    font-size: 0.61rem;
  }

  .truck-day-nav__button strong {
    font-size: 0.68rem;
  }

  .day-grid--truck-single {
    margin-top: 0.28rem;
  }

  .day-cell--truck {
    gap: 0.3rem;
    padding: 0.48rem;
  }

  .day-cell--truck .day-cell__top strong {
    font-size: 0.88rem;
  }

  .day-cell--truck .day-cell__top > span {
    font-size: 0.74rem;
  }

  .day-cell--truck .adjust-row button,
  .day-cell--truck input {
    min-height: 34px;
  }
}

/* ── Invite Status Badges ── */

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 6px;
  font-size: 0.7rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.badge--pending {
  background-color: rgba(255, 140, 0, 0.08);
  color: #FF8C00;
  border: 1px solid #FF8C00;
}

.badge--pending::before {
  content: "";
  width: 6px;
  height: 6px;
  background-color: #FF8C00;
  border-radius: 50%;
  display: inline-block;
  animation: pulse-dot 1.5s infinite;
}

.badge--active {
  background-color: #FF8C00;
  color: white;
  border: none;
}

.badge--accepted {
  background-color: #e8f5e9;
  color: #2e7d32;
  border: 1px solid #4caf50;
}

.badge--expired {
  background-color: rgba(107, 114, 128, 0.08);
  color: #6b7280;
  border: 1px dashed #6b7280;
}

.badge--revoked {
  background-color: rgba(220, 38, 38, 0.08);
  color: #dc2626;
  border: 1px dashed #dc2626;
  text-decoration: line-through;
}

@keyframes pulse-dot {
  0%   { opacity: 1; transform: scale(1); }
  50%  { opacity: 0.4; transform: scale(1.2); }
  100% { opacity: 1; transform: scale(1); }
}

/* ── Resend Button ── */

.invite-status-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
}

.btn--resend {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4px 10px;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: 4px;
  border: 1px solid #FF8C00;
  background-color: transparent;
  color: #FF8C00;
  cursor: pointer;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.btn--resend:hover:not(:disabled) {
  background-color: rgba(255, 140, 0, 0.1);
  transform: translateY(-1px);
}

.btn--resend:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* ── Invite Confirmation Dialog ── */

.modal--confirm {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.modal--confirm .modal__overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: -1;
}

.modal__content--small {
  background-color: white;
  border-radius: 8px;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
  max-width: 400px;
  width: 90%;
  animation: slideUp 0.3s ease;
}

.modal__header {
  padding: 20px;
  border-bottom: 1px solid #e5e7eb;
}

.modal__body {
  padding: 20px;
}

.modal__subtitle {
  font-size: 0.875rem;
  color: #6b7280;
  margin-top: 4px;
}

.modal__actions {
  display: flex;
  gap: 12px;
  padding: 20px;
  border-top: 1px solid #e5e7eb;
  justify-content: flex-end;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Signup After Magic Link ── */

.signup-hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: #f8f9fb;
}

.signup-container {
  max-width: 440px;
  width: 100%;
  background: white;
  border-radius: 20px;
  box-shadow: 0 8px 40px rgba(0, 0, 0, 0.1);
  padding: 40px 36px;
}

.signup-header {
  text-align: center;
  margin-bottom: 28px;
}

.signup-header h1 {
  margin: 0 0 6px;
  font-size: 22px;
  font-weight: 800;
  color: #1a1a1b;
}

.signup-header p {
  margin: 0;
  font-size: 14px;
  color: #808080;
}

/* ── Invite Management Panel ── */

.invite-management-panel {
  margin-top: 24px;
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.invite-panel__filters {
  display: flex;
  gap: 4px;
  padding: 16px 16px 0;
  border-bottom: 1px solid #f0f0f0;
}

.invite-panel__loading,
.invite-panel__empty {
  padding: 32px 20px;
  text-align: center;
  color: #808080;
  font-size: 14px;
}

.invite-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.invite-table th {
  padding: 10px 14px;
  text-align: left;
  font-weight: 600;
  color: #888;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  background: #fafafa;
}

.invite-table td {
  padding: 12px 14px;
  border-bottom: 1px solid #f5f5f5;
}

.invite-row__email {
  font-weight: 500;
  color: #1a1a1b;
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab {
  padding: 6px 12px;
  border-radius: 6px 6px 0 0;
  border: none;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: #808080;
  font-size: 13px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.tab--active {
  border-bottom-color: #FF8C00;
  background: #fff3e0;
  color: #FF8C00;
  font-weight: 700;
}

.tab__count {
  background: #e0e0e0;
  color: #666;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  padding: 1px 6px;
  min-width: 18px;
  text-align: center;
}

.tab--active .tab__count {
  background: #FF8C00;
  color: white;
}

/* ── QBO / Payroll Export ── */
.export-summary {
  margin-bottom: 20px;
}

.summary-row {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}

.alert {
  padding: 12px 16px;
  border-radius: 6px;
  font-size: 13px;
  margin-bottom: 12px;
}

.alert--warning {
  background-color: #fffbf0;
  border: 1px solid #f0c040;
  color: #856404;
}

.alert--error {
  background-color: #fdf2f2;
  border: 1px solid #f5c6c6;
  color: #c0392b;
}

.export-history-table {
  width: 100%;
  overflow-x: auto;
}

.card {
  transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.5s, border-color 0.5s, background-color 0.5s;
}

.card:hover {
  transform: translateY(-4px);
}

